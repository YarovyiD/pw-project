# Офіційний образ Playwright з уже встановленими браузерами
# Версія ТОЧНО збігається з твоєю @playwright/test (1.63.0)
FROM mcr.microsoft.com/playwright:v1.63.0-jammy

# Робоча папка всередині контейнера
WORKDIR /app

# Спершу копіюємо тільки package-файли (для кешування залежностей)
COPY package*.json ./

# Встановлюємо залежності
RUN npm ci

# Тепер копіюємо весь інший код проєкту
COPY . .

# Команда за замовчуванням при запуску контейнера
CMD ["npx", "playwright", "test"]
